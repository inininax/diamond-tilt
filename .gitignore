# Unity test runner output
TestResults/
results.xml
Coverage/

# Crashlytics generated file (if used later)
crashlytics-build.properties
/[Aa]ssets/StreamingAssets/aa/*
/[Aa]ssets/StreamingAssets/aa.meta

# Visual Studio / Rider cache
.vs/
.vscode/
.idea/
